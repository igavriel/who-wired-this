{
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#e66963",
        "activityBar.background": "#e66963",
        "activityBar.foreground": "#15202b",
        "activityBar.inactiveForeground": "#15202b99",
        "activityBarBadge.background": "#126e16",
        "activityBarBadge.foreground": "#e7e7e7",
        "commandCenter.border": "#e7e7e799",
        "sash.hoverBorder": "#e66963",
        "statusBar.background": "#df3f37",
        "statusBar.foreground": "#e7e7e7",
        "statusBarItem.hoverBackground": "#e66963",
        "statusBarItem.remoteBackground": "#0d5210",
        "statusBarItem.remoteForeground": "#e7e7e7",
        "titleBar.activeBackground": "#df3f37",
        "titleBar.activeForeground": "#595959",
        "titleBar.inactiveBackground": "#df3f3799",
        "titleBar.inactiveForeground": "#e7e7e799",
        "activityBarTop.activeBackground": "#e66963",
        "activityBarTop.background": "#e66963",
        "activityBarTop.foreground": "#15202b",
        "activityBarTop.inactiveForeground": "#15202b99",
        "commandCenter.foreground": "#595959",
        "statusBar.debuggingBackground": "#df3f37",
        "statusBar.debuggingForeground": "#e7e7e7"
    },
    "peacock.color": "#df3f37",
    "omnisharp.useModernNet": true,
    "omnisharp.defaultLaunchSolution": "who-wired-this.sln",
    "omnisharp.enableRoslynAnalyzers": false,
    "omnisharp.enableDecompilationSupport": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.watcherExclude": {
        "**/Library/**": true,
        "**/Temp/**": true,
        "**/Obj/**": true,
        "**/Logs/**": true,
        "**/.git/**": true
    },
    "files.exclude": {
        "**/.vs": true,
        "**/Obj": true
    },
    "search.exclude": {
        "**/Library": true,
        "**/Temp": true,
        "**/Obj": true,
        "**/Logs": true,
        "**/*.meta": true
    },
    "dotnet.defaultSolution": "who-wired-this.slnx"
}
